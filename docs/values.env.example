# =============================================================================
# values.env.example
#
# This is a REFERENCE SHEET, not a script that gets sourced by anything in
# this kit automatically. Copy it to a local, gitignored file (e.g.
# `values.env`) and fill in YOUR real values, then keep it open alongside
# docs/03-runbook-day-of.md on stand-up day so you're not hunting through
# multiple docs for the same numbers.
#
# DO NOT COMMIT A FILLED-IN COPY OF THIS FILE. It is excluded via
# .gitignore's `*.env` rule once you name it anything other than
# `*.env.example`. If you rename it to something that doesn't match that
# pattern, add it to .gitignore explicitly before filling it in.
# =============================================================================

# --- VLAN IDs and subnets (see docs/02-network-setup.md) -------------------
VLAN_TRUSTED_ID=10
VLAN_TRUSTED_SUBNET=192.168.10.0/24

VLAN_PROD_ID=20
VLAN_PROD_SUBNET=192.168.20.0/24

VLAN_DEV_ID=21
VLAN_DEV_SUBNET=192.168.21.0/24

VLAN_MGMT_ID=30
VLAN_MGMT_SUBNET=192.168.30.0/24

# --- Static IPs to assign during OS install (scripts/02, docs/03) ----------
PROXMOX_MGMT_IP=192.168.30.5
IDRAC_IP=192.168.30.6

DUNE_PROD_VM_IP=192.168.20.10
DUNE_DEV_VM_IP=192.168.21.10

# --- Proxmox VM IDs (used by scripts/02-provision-vms.sh) -------------------
PROD_VMID=101
DEV_VMID=102

# --- Bridge names (adjust to match your actual Proxmox network config) -----
PROD_BRIDGE=vmbr0
DEV_BRIDGE=vmbr0

# --- Your real public-facing values (fill in, keep private) -----------------
PUBLIC_IP=
SERVER_TITLE_PROD="Tabr Tau"
SERVER_TITLE_DEV="Tabr Tau - Dev"
SERVER_REGION="North America"

# --- Funcom Self-Host Service Tokens ----------------------------------------
# DO NOT put the actual token strings in this file, even locally. Store
# them in your password manager and paste them directly into the `dune
# init` prompt when scripts/04 or scripts/05 ask for them. This section
# exists only so you remember WHICH account maps to WHICH environment.
FUNCOM_ACCOUNT_FOR_PROD=       # e.g. "account #1 - primary email"
FUNCOM_ACCOUNT_FOR_DEV=        # e.g. "account #2 - secondary email"
FUNCOM_ACCOUNT_SPARE=          # account #3, banked for a future 3rd battlegroup

# --- Router port forwards (see docs/02-network-setup.md Step 4/5) ---------
# Prod = Instance 1 (stock ports). Dev = Instance 2 (+1000 offset,
# issue #83/#85 -- Dev now gets real WAN forwards, reversing the
# earlier LAN/VPN-only decision).
FORWARD_UDP_GAME_RANGE=7777-7810
FORWARD_TCP_RMQ_GAME=31982
FORWARD_TCP_RMQ_HTTP=31983

FORWARD_DEV_UDP_GAME_RANGE=8777-8810
FORWARD_DEV_TCP_RMQ_GAME=32982
FORWARD_DEV_TCP_RMQ_HTTP=32983

# --- Backup file naming (see scripts/06, scripts/04) ------------------------
# Filled in on the day - just a place to jot the actual filename/checksum
# so you're not scrolling back through terminal history to find it.
FINAL_BACKUP_FILENAME=
FINAL_BACKUP_SHA256=
