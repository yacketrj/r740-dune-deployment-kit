# Copy to /root/.config/r740-backup/backup.env (mode 0600) ONCE. `backup-key.sh generate`
# creates this file from this template and fills in BK_AGE_RECIPIENT itself; if the file
# already exists, EDIT it in place -- never copy this template over it.
# No secrets belong here; secret values live in their own root-only (0600) files below.

# --- encryption (filled in by scripts/backup-key.sh generate) ---
# Only the PUBLIC recipient lives on the host. The private key is kept off the host
# (password manager + second escrow) and is never configured here.
BK_AGE_RECIPIENT=
BK_AGE_RECIPIENT_CREATED=

# --- local paths ---
BK_STAGE_DIR=/mnt/backup-stage
BK_STATE_DIR=/var/lib/r740-backup

# --- second-machine target (SMB share mounted on the host) ---
BK_SMB_MOUNT=/mnt/desktop-backup
# Optional: doctor checks this file is mode 0600 if set.
BK_SMB_CREDENTIALS_FILE=/root/.config/r740-backup/smb-credentials

# --- optional cloud target: an rclone crypt remote (e.g. OneDrive). LEAVE EMPTY to use the
# share alone (then copy the share to external media yourself; see the runbook, section 9).
# If set, it is both what the jobs write to and what you use when restoring on a bare box.
BK_RCLONE_REMOTE=
# BK_RCLONE_BWLIMIT=8M

# --- the pull from dune-prod (restricted key + pinned host key, see the runbook) ---
BK_BACKUP_SSH=dune@192.168.20.10
BK_BACKUP_SSH_KEY=/root/.config/r740-backup/backup_ed25519
BK_KNOWN_HOSTS=/root/.config/r740-backup/known_hosts

# --- what to back up ---
BK_HOST_PATHS="etc/pve etc/network/interfaces etc/hosts etc/hostname etc/cloudflared etc/vzdump.conf"
BK_VMIDS="101 102 103 104"
BK_KEEP_WEEKLY_DEFAULT=3
BK_KEEP_WEEKLY_102=1

# --- alerting ---
BK_DISCORD_WEBHOOK_FILE=/root/.config/r740-backup/discord-webhook
# A Discord mention that turns a failure into a real ping. This file is read as shell, so
# QUOTE it: BK_ALERT_MENTION='<@123456789>'. Empty = no ping.
BK_ALERT_MENTION=
# Where the alert's runbook link should point (a clickable URL).
BK_RUNBOOK_URL=
# One dead-man's-switch check for the backup jobs and one for the hourly alarm: files that
# contain a Healthchecks-style ping URL (a failure is reported by appending /fail).
# BK_DEADMAN_URL_FILE=/root/.config/r740-backup/deadman-url
# BK_CHECK_DEADMAN_URL_FILE=/root/.config/r740-backup/deadman-check-url
# Set BK_HEARTBEAT_REQUIRED=0 to run without them (the doctor then only warns).
# Optional: a directory (e.g. on the share) that receives a copy of the audit log.
BK_AUDIT_SHIP_DIR=

# --- restore drills (see the runbook, section 7) ---
BK_DRILL_SSH=dune@192.168.21.10
BK_DRILL_KNOWN_HOSTS=/root/.config/r740-backup/known_hosts_dev
BK_DRILL_PG_IMAGE=
BK_DRILL_MIN_TABLES=
BK_DRILL_ROW_CHECKS=
# Throwaway container limits; the tmpfs must be larger than the restored database.
BK_DRILL_MEMORY=4g
BK_DRILL_TMPFS_SIZE=2g
# One in-guest check command per guest, e.g.:
# BK_DRILL_VM_CHECK_101="docker exec dune-postgres pg_isready -U postgres"

# --- VM restore drill guardrails (see the runbook, "How the VM restore drill protects the host and dune-prod") ---
# Defaults shown; every one is validated, and an unbounded restore rate is refused.
# BK_DRILL_BLACKOUT=04:20-05:20          # no drill may overlap this window (04:30 dump, 05:00 game restart)
# BK_DRILL_GUARD=1                       # exactly 1 or 0; 0 is recorded in the audit log
# BK_DRILL_GUARD_IO_METRIC=full          # PSI line the guard judges I/O on (some|full)
# BK_DRILL_GUARD_IO_MAX=20
# BK_DRILL_BWLIMIT_KIB=40960             # restore speed cap, KiB/s (1024-102400)
# BK_DRILL_RESTORE_MEMHIGH=2G            # page-cache ceiling for the restore (cgroup MemoryHigh)
# BK_DRILL_RESTORE_TIMEOUT_MIN=150
# BK_DRILL_DIRTY_TUNE=1                  # lower the kernel dirty-page limits during the restore
# BK_DRILL_DIRTY_MB=256
# BK_DRILL_DIRTY_BG_MB=64
# BK_DRILL_VM_MEMORY_MB=8192
# BK_DRILL_VM_CORES=4
# BK_DRILL_NUMA_NODE=1                   # bind the scratch guest's memory to this host node
# BK_DRILL_AFFINITY=1,3,5,7              # host threads for its vCPUs (dune-dev's)
# BK_DRILL_CPUUNITS=10                   # lowest CPU weight
# BK_DRILL_DISK_MBPS_RD=60
# BK_DRILL_DISK_MBPS_WR=30
# BK_DRILL_MIN_AVAIL_GB=40
# BK_DRILL_NODE_HEADROOM_MB=16384
# BK_DRILL_MIN_POOL_FREE_GB=200
# Guard: memory pressure and thin-pool metadata limits (the weekly job uses them too)
# BK_GUARD_MEM_PRESSURE_MAX=10
# BK_GUARD_META_MAX=70

# --- safety guard and in-game announcements (see the runbook, "Protecting live players") ---
# The weekly job's --guard / --announce switches can be made the default here (1 = on).
# BK_WEEKLY_GUARD=0
# BK_WEEKLY_ANNOUNCE=0
# Guard thresholds (3 bad samples in a row, one sample every 10 s, stop the job).
# BK_GUARD_IO_PRESSURE_MAX=30
# BK_GUARD_DISK_BUSY_MAX=95
# BK_GUARD_POOL_MAX=85
# BK_GUARD_GAME_SSH=dune@192.168.20.10
# Console broadcast API and a root-only file holding a key limited to the admin:broadcast action.
# BK_ANNOUNCE_URL=http://192.168.20.10:8088
# BK_ANNOUNCE_KEY_FILE=/root/.config/r740-backup/announce-key
# Minutes before the start at which warnings go out, the repeat interval while running, and which guests.
# BK_ANNOUNCE_LEAD_MINUTES="30 15 5 1"
# BK_ANNOUNCE_EVERY_MIN=30
# BK_ANNOUNCE_GUESTS="101"
# BK_ANNOUNCE_DURATION_S=40
