[Unit]
Description=Prometheus exporter for Proxmox VE (read-only token, meta#99)
After=pveproxy.service network-online.target

[Service]
User=prometheus
Group=prometheus
ExecStart=/opt/pve-exporter/bin/pve_exporter --config.file=/etc/prometheus-pve-exporter/pve.yml --web.listen-address=127.0.0.1:9221
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
