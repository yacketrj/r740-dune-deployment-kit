          "legendFormat": "players online",
          "refId": "A"
        }
      ]
    },
    {
      "id": 39,
      "type": "timeseries",
      "title": "Bursts alongside players",
      "description": "Bursts per interval (all maps) next to players online, to see whether load or something else drives them.",
