{
  "uid": "dune-game",
  "title": "Dune - Game state and players",
  "description": "Population, map readiness, memory and FLS health from the console API (meta#99). Private.",
  "tags": [
    "dune",
    "game"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "#d55181",
        "name": "Changes",
        "target": {
          "type": "tags",
          "tags": [
            "change"
          ],
          "limit": 100,
          "matchAny": false,
          "queryType": "tags"
        }
      }
    ]
  },
  "templating": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 32,
      "type": "stat",
      "title": "Server state",
      "description": "1 = overall READY according to the console API.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "dune_server_ready",
          "legendFormat": "",
          "refId": "A"
        }
